{
 "market": "SE",
 "min_interval_s": 3.0,
 "sources": [
  {
   "id": "snapshot_se",
   "adapter": "manual_snapshot",
   "retailer": "(snapshot)",
   "country": "SE",
   "path": "data/snapshots",
   "glob": "*_se_*.json",
   "enabled": true,
   "status_note": "Real listings captured on 2026-11-15 with product and image URLs. Replaced by live sources once the scheduled crawler runs."
  },
  {
   "id": "booztlet_se",
   "adapter": "jsonld",
   "retailer": "Booztlet",
   "country": "SE",
   "currency": "SEK",
   "listing_urls": [
    "https://www.booztlet.com/se/sv/kvinnor/home/kok?page={page}",
    "https://www.booztlet.com/se/sv/kvinnor/home/mobler?page={page}",
    "https://www.booztlet.com/se/sv/kvinnor/home/textilier?page={page}",
    "https://www.booztlet.com/se/sv/kvinnor/skor?page={page}",
    "https://www.booztlet.com/se/sv/man/skor?page={page}",
    "https://www.booztlet.com/se/sv/barn/skor?page={page}",
    "https://www.booztlet.com/se/sv/kvinnor/klader?page={page}",
    "https://www.booztlet.com/se/sv/man/klader?page={page}",
    "https://www.booztlet.com/se/sv/barn/klader?page={page}"
   ],
   "pages": 3,
   "link_pattern": "/se/sv/[^/]+/[^/]+_\\d+/\\d+$",
   "max_products": 1500,
   "default_condition": "clearance",
   "allowed_hosts": [
    "booztlet.com"
   ],
   "enabled": true,
   "status_note": "Official Boozt outlet. Listing pages carry product links and images; product pages read via schema.org. Booztlet also runs an affiliate programme on Tradedoubler: switch to the feed once approved."
  },
  {
   "id": "thenorthface_se",
   "adapter": "jsonld",
   "retailer": "The North Face",
   "country": "SE",
   "currency": "SEK",
   "listing_urls": [
    "https://www.thenorthface.com/sv-se/c/outlet/outlet-for-herr-550274?page={page}",
    "https://www.thenorthface.com/sv-se/c/outlet/outlet-for-dam-550273?page={page}",
    "https://www.thenorthface.com/sv-se/c/outlet/outlet-skor-550277?page={page}"
   ],
   "pages": 5,
   "link_pattern": "/sv-se/p/",
   "max_products": 600,
   "default_condition": "clearance",
   "allowed_hosts": [
    "thenorthface.com"
   ],
   "enabled": true,
   "status_note": "Brand outlet, server-rendered with images."
  },
  {
   "id": "ikea_last_chance_se",
   "adapter": "jsonld",
   "retailer": "IKEA",
   "country": "SE",
   "currency": "SEK",
   "listing_urls": [
    "https://www.ikea.com/se/sv/cat/last-chance/?page={page}"
   ],
   "pages": 10,
   "link_pattern": "/se/sv/p/[^/]+-s?\\d+/$",
   "max_products": 800,
   "default_condition": "last_chance",
   "allowed_hosts": [
    "ikea.com"
   ],
   "enabled": true,
   "status_note": "IKEA Utgår inom kort: produkter som utgår, med bild och pris. Rabatt visas bara om IKEA anger tidigare pris."
  },
  {
   "id": "elgiganten_outlet_se",
   "adapter": "feed",
   "format": "google",
   "retailer": "Elgiganten",
   "country": "SE",
   "url": "${ELGIGANTEN_FEED_URL}",
   "enabled": false,
   "status_note": "Large appliances (vitvaror). Outlet product pages exist but prices render client-side and differ between views, so they are not scraped. Needs an affiliate product feed."
  },
  {
   "id": "ikea_circular_se",
   "adapter": "jsonld",
   "retailer": "IKEA Cirkulärt",
   "country": "SE",
   "listing_urls": [],
   "enabled": false,
   "status_note": "IKEA Cirkulärbutik (begagnat, visningsex.) per varuhus: listorna laddas bara i webbläsaren och är inte läsbara utan headless-arbetare eller samarbete med IKEA."
  },
  {
   "id": "jula_outlet_se",
   "adapter": "jsonld",
   "retailer": "Jula",
   "country": "SE",
   "listing_urls": [
    "https://www.jula.se/catalog/outlet"
   ],
   "link_pattern": "/catalog/.+-\\d+/$",
   "enabled": false,
   "status_note": "Outlet list is readable but exposes no product links or images to a plain reader. To verify with a real crawler run."
  },
  {
   "id": "inet_fynd_se",
   "adapter": "inet",
   "retailer": "Inet",
   "country": "SE",
   "currency": "SEK",
   "listing_url": "https://www.inet.se/fyndhornan",
   "pages": 10,
   "default_condition": "open_box",
   "allowed_hosts": [
    "inet.se"
   ],
   "enabled": true,
   "status_note": "Fyndhörnan: returns, open box and manufacturer replacements, with store stock. Items sell within hours, so it runs every 3 h."
  },
  {
   "id": "cremashop_outlet_se",
   "adapter": "jsonld",
   "retailer": "Cremashop",
   "country": "SE",
   "currency": "SEK",
   "listing_urls": [
    "https://www.cremashop.se/en/outlet?page={page}"
   ],
   "pages": 3,
   "link_pattern": "/en/outlet/\\d+$",
   "max_products": 200,
   "default_condition": "demo",
   "allowed_hosts": [
    "cremashop.se"
   ],
   "enabled": true,
   "status_note": "Outlet: demo units, briefly tested or warranty-serviced machines and dented packaging. One unit per listing."
  },
  {
   "id": "kjell_outlet_se",
   "adapter": "jsonld",
   "retailer": "Kjell & Company",
   "country": "SE",
   "currency": "SEK",
   "listing_urls": [
    "https://www.kjell.com/se/outlet?page={page}"
   ],
   "pages": 50,
   "link_pattern": "\\?outlet=[abc]$",
   "max_products": 3000,
   "default_condition": "returned",
   "allowed_hosts": [
    "kjell.com"
   ],
   "enabled": true,
   "status_note": "Graded returns (Nyskick / Mycket bra skick / Bra skick) with store counts, about 2,400 items. If product pages lack schema.org, request Kjell's Adtraction feed instead."
  },
  {
   "id": "proshop_demo_se",
   "adapter": "jsonld",
   "retailer": "Proshop",
   "country": "SE",
   "currency": "SEK",
   "listing_urls": [
    "https://www.proshop.se/Demo?page={page}"
   ],
   "pages": 5,
   "default_condition": "demo",
   "allowed_hosts": [
    "proshop.se"
   ],
   "enabled": false,
   "status_note": "DEALS OUTLET / demo items exist, listing URL to be confirmed on first live run."
  },
  {
   "id": "netonnet_outlet_se",
   "adapter": "feed",
   "retailer": "NetOnNet",
   "country": "SE",
   "enabled": false,
   "status_note": "Outlet/B-stock pages are JS-rendered. Needs an affiliate feed (Adtraction)."
  },
  {
   "id": "webhallen_fynd_se",
   "adapter": "feed",
   "retailer": "Webhallen",
   "country": "SE",
   "enabled": false,
   "status_note": "Fyndhörnan is loaded by JS API. Needs a feed or permission."
  },
  {
   "id": "komplett_bstock_se",
   "adapter": "feed",
   "retailer": "Komplett",
   "country": "SE",
   "enabled": false,
   "status_note": "Demo/B-varor are JS-rendered. Needs an affiliate feed."
  }
 ]
}