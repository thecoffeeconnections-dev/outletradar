{
  "min_interval_s": 3.0,
  "sources": [
    {
      "id": "snapshot",
      "adapter": "manual_snapshot",
      "retailer": "(snapshot)",
      "country": "SE",
      "path": "data/snapshots",
      "glob": "*_manual.json",
      "enabled": true,
      "status_note": "Real listings captured by hand on 2026-11-15 to seed the site. Disable once live sources run."
    },
    {
      "id": "inet_se",
      "adapter": "inet",
      "retailer": "Inet",
      "country": "SE",
      "currency": "SEK",
      "url": "https://www.inet.se/fyndhornan",
      "max_pages": 40,
      "allowed_hosts": ["inet.se"],
      "enabled": true,
      "status_note": "Server-rendered listing. Parser built from page text; confirm selectors on the first networked run."
    },
    {
      "id": "proshop_dk",
      "adapter": "jsonld",
      "retailer": "Proshop",
      "country": "DK",
      "currency": "DKK",
      "listing_urls": ["https://www.proshop.dk/Demo-produkter?pn={page}"],
      "pages": 10,
      "link_pattern": "DEMO/\\d+d$",
      "max_products": 400,
      "default_condition": "demo",
      "allowed_hosts": ["proshop.dk"],
      "enabled": true,
      "status_note": "Demo SKUs end in 'd'. Product pages read via schema.org JSON-LD."
    },
    {
      "id": "proshop_se",
      "adapter": "jsonld",
      "retailer": "Proshop",
      "country": "SE",
      "currency": "SEK",
      "listing_urls": ["https://www.proshop.se/Demo-produkter?pn={page}"],
      "pages": 10,
      "link_pattern": "DEMO/\\d+d$",
      "max_products": 400,
      "default_condition": "demo",
      "allowed_hosts": ["proshop.se"],
      "enabled": true,
      "status_note": "Same platform as proshop.dk; listing URL to confirm on first run."
    },
    {
      "id": "proshop_no",
      "adapter": "jsonld",
      "retailer": "Proshop",
      "country": "NO",
      "currency": "NOK",
      "listing_urls": ["https://www.proshop.no/Demo-produkter?pn={page}"],
      "pages": 10,
      "link_pattern": "DEMO/\\d+d$",
      "max_products": 400,
      "default_condition": "demo",
      "allowed_hosts": ["proshop.no"],
      "enabled": true,
      "status_note": "Same platform as proshop.dk; listing URL to confirm on first run."
    },
    {
      "id": "thomann_dk",
      "adapter": "jsonld",
      "retailer": "Thomann",
      "country": "DK",
      "currency": "DKK",
      "sitemaps": ["https://www.thomann.dk/sitemap.xml"],
      "link_pattern": "_b_stock",
      "max_products": 300,
      "default_condition": "open_box",
      "allowed_hosts": ["thomann.dk"],
      "enabled": false,
      "status_note": "B-stock pages are public; sitemap path unverified. Thomann also runs an affiliate programme: prefer its feed."
    },
    {
      "id": "elgiganten_elkjop",
      "adapter": "feed",
      "format": "google",
      "retailer": "Elgiganten / Elkjøp",
      "country": "SE",
      "url": "${ELGIGANTEN_FEED_URL}",
      "enabled": false,
      "status_note": "Outlet pages render in the browser (no product data in HTML). Needs an affiliate product feed or a headless-browser worker. Blocker: affiliate approval."
    },
    {
      "id": "adtraction_example",
      "adapter": "feed",
      "format": "adtraction",
      "retailer": "(Adtraction advertiser)",
      "country": "SE",
      "url": "${ADTRACTION_FEED_URL_1}",
      "min_discount_pct": 25,
      "enabled": false,
      "status_note": "Template. Copy per approved Adtraction programme; paste the feed URL into a GitHub secret."
    },
    {
      "id": "partnerads_example",
      "adapter": "feed",
      "format": "partnerads",
      "retailer": "(Partner-ads advertiser)",
      "country": "DK",
      "url": "${PARTNERADS_FEED_URL_1}",
      "min_discount_pct": 25,
      "enabled": false,
      "status_note": "Template for Danish advertisers on Partner-ads."
    },
    {
      "id": "awin_example",
      "adapter": "feed",
      "format": "awin_csv",
      "retailer": "(Awin advertiser)",
      "country": "NO",
      "url": "${AWIN_FEED_URL_1}",
      "min_discount_pct": 25,
      "enabled": false,
      "status_note": "Template for Awin Create-a-Feed CSV."
    }
  ]
}
